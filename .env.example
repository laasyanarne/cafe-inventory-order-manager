# ── Database ───────────────────────────────────────────────────────────────────
# MySQL connection details.
# Local development: use your Docker-mapped port (3307 by default).
# Production (Aiven): copy the values from your Aiven service's Overview tab.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=defaultdb

# TLS / SSL — required for Aiven MySQL (and most managed MySQL services).
# Two accepted formats:
#   a) A filesystem path: DB_SSL_CA=/path/to/ca.pem
#   b) The raw PEM content (paste the full certificate text, newlines included).
#      This is the format to use when setting the variable in Render's dashboard.
# Leave blank to disable SSL (local Docker only).
DB_SSL_CA=

# ── Auth ───────────────────────────────────────────────────────────────────────
# Long random secret used to sign JWT tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_secret

# ── CORS ───────────────────────────────────────────────────────────────────────
# The frontend URL the backend will accept requests from.
# Local development: leave unset (defaults to http://localhost:5173).
# Production: set to your exact Vercel deployment URL, no trailing slash.
# Example: https://halwa-cafe.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# ── Server ─────────────────────────────────────────────────────────────────────
# Port Flask listens on when run directly (python app.py).
# Render sets PORT automatically — do not override it in production.
PORT=5001

# ── Demo accounts ──────────────────────────────────────────────────────────────
# Passwords for the two demo login accounts.
# Used only when running: python server/scripts/create_demo_accounts.py
# Must be at least 8 characters each. Never commit real values.
DEMO_MANAGER_PASSWORD=replace_with_manager_password
DEMO_EMPLOYEE_PASSWORD=replace_with_employee_password
